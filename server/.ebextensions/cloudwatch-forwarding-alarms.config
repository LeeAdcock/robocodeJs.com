# CloudWatch metric-filter alarms for multi-instance request forwarding
# (GitHub #444): each user has a home instance (user_home lease) and other
# instances forward that user's requests there (server/src/middleware/forward.ts).
#
# Same mechanism and conventions as cloudwatch-alarms.config: quoted substring
# filter patterns on the pino JSON `event` field in web.stdout.log, alarming to
# ALERT_SNS_TOPIC_ARN (default: the `Alerts` topic). Depends on
# cloudwatch-logs.config having created the log group.
#
# The 421 (misdirected) rate isn't alarmed: 421s are counted in /health
# (misdirectedRequests) but not logged per request. A misdirect is a cheap,
# self-correcting retry, and the conditions that cause many of them surface
# here as home.lost / home.takeover anyway.

Resources:
  # event="forward.failed" — Each event is a request the user saw fail (503, Retry-After). Expected: ~0.
  # Graceful shutdown hands leases back before the old instance stops, so
  # deploys shouldn't produce these; a burst means a home is unreachable on
  # 8080 (the instance-forwarding security-group rule) or died uncleanly.
  ForwardFailedMetricFilter:
    Type: 'AWS::Logs::MetricFilter'
    Properties:
      LogGroupName:
        'Fn::GetOptionSetting':
          Namespace: 'aws:elasticbeanstalk:application:environment'
          OptionName: 'ALERT_LOG_GROUP'
          DefaultValue: '/aws/elasticbeanstalk/robocode-prod/var/log/web.stdout.log'
      FilterPattern: '"\"event\":\"forward.failed\""'
      MetricTransformations:
        - MetricNamespace: 'RobocodeJs/Forwarding'
          MetricName: 'ForwardFailed'
          MetricValue: '1'
          DefaultValue: 0
  ForwardFailedAlarm:
    Type: 'AWS::CloudWatch::Alarm'
    Properties:
      AlarmName: 'robocodejs-forward-failed'
      AlarmDescription: "Requests that could not be forwarded to the user's home instance (event=forward.failed): each one is a 503 the user saw. A burst means an instance is unreachable on 8080 (security group) or dying without releasing its leases."
      Namespace: 'RobocodeJs/Forwarding'
      MetricName: 'ForwardFailed'
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 5
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - 'Fn::GetOptionSetting':
            Namespace: 'aws:elasticbeanstalk:application:environment'
            OptionName: 'ALERT_SNS_TOPIC_ARN'
            DefaultValue: 'arn:aws:sns:us-east-1:095207682014:Alerts'

  # event="forward.rejected" — A forwarding marker whose HMAC didn't verify. Between our own
  # instances that means INTERNAL_FORWARD_SECRET differs (a half-applied
  # rotation): every forward from one side is then served as a plain request,
  # i.e. forwarding is silently off. From outside it is a forgery attempt, which
  # earns nothing (the request is treated as ordinary). Either way worth a look.
  ForwardRejectedMetricFilter:
    Type: 'AWS::Logs::MetricFilter'
    Properties:
      LogGroupName:
        'Fn::GetOptionSetting':
          Namespace: 'aws:elasticbeanstalk:application:environment'
          OptionName: 'ALERT_LOG_GROUP'
          DefaultValue: '/aws/elasticbeanstalk/robocode-prod/var/log/web.stdout.log'
      FilterPattern: '"\"event\":\"forward.rejected\""'
      MetricTransformations:
        - MetricNamespace: 'RobocodeJs/Forwarding'
          MetricName: 'ForwardRejected'
          MetricValue: '1'
          DefaultValue: 0
  ForwardRejectedAlarm:
    Type: 'AWS::CloudWatch::Alarm'
    Properties:
      AlarmName: 'robocodejs-forward-rejected'
      AlarmDescription: "Requests carrying a forwarding marker whose signature did not verify (event=forward.rejected): INTERNAL_FORWARD_SECRET differs between instances, or someone is forging the headers."
      Namespace: 'RobocodeJs/Forwarding'
      MetricName: 'ForwardRejected'
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 10
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - 'Fn::GetOptionSetting':
            Namespace: 'aws:elasticbeanstalk:application:environment'
            OptionName: 'ALERT_SNS_TOPIC_ARN'
            DefaultValue: 'arn:aws:sns:us-east-1:095207682014:Alerts'

  # event="home.lost" — Another instance took a user's home while this one still held it,
  # i.e. this instance went 30 s without renewing (event loop stalled, or the
  # database unreachable from here but not from there). The user's arenas are
  # dropped here and their match restarts on the new home.
  HomeLostMetricFilter:
    Type: 'AWS::Logs::MetricFilter'
    Properties:
      LogGroupName:
        'Fn::GetOptionSetting':
          Namespace: 'aws:elasticbeanstalk:application:environment'
          OptionName: 'ALERT_LOG_GROUP'
          DefaultValue: '/aws/elasticbeanstalk/robocode-prod/var/log/web.stdout.log'
      FilterPattern: '"\"event\":\"home.lost\""'
      MetricTransformations:
        - MetricNamespace: 'RobocodeJs/Forwarding'
          MetricName: 'HomeLost'
          MetricValue: '1'
          DefaultValue: 0
  HomeLostAlarm:
    Type: 'AWS::CloudWatch::Alarm'
    Properties:
      AlarmName: 'robocodejs-home-lost'
      AlarmDescription: "Another instance took over a user home this instance still held (event=home.lost): this instance failed to renew for 30 s. Its copies of those users' arenas were dropped, restarting their matches."
      Namespace: 'RobocodeJs/Forwarding'
      MetricName: 'HomeLost'
      Statistic: Sum
      Period: 300
      EvaluationPeriods: 1
      Threshold: 3
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - 'Fn::GetOptionSetting':
            Namespace: 'aws:elasticbeanstalk:application:environment'
            OptionName: 'ALERT_SNS_TOPIC_ARN'
            DefaultValue: 'arn:aws:sns:us-east-1:095207682014:Alerts'

  # event="home.takeover" — An instance claimed a home whose lease had expired: its holder died
  # or stalled without handing it back. A few after a crash are expected (that
  # is the mechanism working); a steady stream means instances are going away
  # uncleanly. Longer window, higher threshold: this is a trend alarm.
  HomeTakeoverMetricFilter:
    Type: 'AWS::Logs::MetricFilter'
    Properties:
      LogGroupName:
        'Fn::GetOptionSetting':
          Namespace: 'aws:elasticbeanstalk:application:environment'
          OptionName: 'ALERT_LOG_GROUP'
          DefaultValue: '/aws/elasticbeanstalk/robocode-prod/var/log/web.stdout.log'
      FilterPattern: '"\"event\":\"home.takeover\""'
      MetricTransformations:
        - MetricNamespace: 'RobocodeJs/Forwarding'
          MetricName: 'HomeTakeover'
          MetricValue: '1'
          DefaultValue: 0
  HomeTakeoverAlarm:
    Type: 'AWS::CloudWatch::Alarm'
    Properties:
      AlarmName: 'robocodejs-home-takeover'
      AlarmDescription: "Instances are taking over user homes whose leases expired (event=home.takeover): an instance died or stalled without handing its users back."
      Namespace: 'RobocodeJs/Forwarding'
      MetricName: 'HomeTakeover'
      Statistic: Sum
      Period: 900
      EvaluationPeriods: 1
      Threshold: 10
      ComparisonOperator: GreaterThanOrEqualToThreshold
      TreatMissingData: notBreaching
      AlarmActions:
        - 'Fn::GetOptionSetting':
            Namespace: 'aws:elasticbeanstalk:application:environment'
            OptionName: 'ALERT_SNS_TOPIC_ARN'
            DefaultValue: 'arn:aws:sns:us-east-1:095207682014:Alerts'
