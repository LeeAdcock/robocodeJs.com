# Let instances reach each other's node process directly (GitHub #444).
#
# Arena state lives in one process's memory, so each user has a "home"
# instance (the user_home lease table) and, from phase 3 of #444, any other
# instance forwards that user's requests there. It forwards to the address the
# home wrote into its lease, `http://<private-ip>:8080`: node itself, not nginx
# on port 80, so a forwarded request doesn't pass through a second proxy and
# its SSE streams aren't buffered twice.
#
# Until now the instance security group only admitted port 80 from the load
# balancer. This rule admits 8080 from the same security group, i.e. from the
# other instances of this environment and nothing else: the source is the group
# itself, not a CIDR, so neither the internet nor the load balancer can reach
# 8080. Immutable deploys launch their temporary instances into this same group,
# so the old and new instances can reach each other during the overlap, which
# is exactly when forwarding first matters.
#
# Forwarded requests are additionally signed with INTERNAL_FORWARD_SECRET (an
# environment property set out-of-band, never in this repo); see the server
# README. Nothing listens for them until phase 3, so this rule changes nothing
# on its own.
Resources:
  AWSEBInstanceForwardingIngress:
    Type: 'AWS::EC2::SecurityGroupIngress'
    Properties:
      Description: 'Instance-to-instance request forwarding (GitHub #444)'
      GroupId:
        'Fn::GetAtt': ['AWSEBSecurityGroup', 'GroupId']
      SourceSecurityGroupId:
        'Fn::GetAtt': ['AWSEBSecurityGroup', 'GroupId']
      IpProtocol: tcp
      FromPort: 8080
      ToPort: 8080
