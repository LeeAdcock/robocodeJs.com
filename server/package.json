{
  "name": "@robocodejs/server",
  "version": "1.2.137",
  "description": "RobocodeJs API server and game-simulation engine — an Express + TypeScript API with the isolated-vm bot sandbox.",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "fuser -k 8080/tcp & npm run build && run-p dev:tsc dev:node",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --watch ./dist/src/index.js",
    "lint": "npx prettier --write src test && npx eslint src --fix",
    "lint:eslint": "eslint src --fix",
    "start": "node ./dist/src/index.js",
    "smoke": "node ./scripts/ivm-smoke.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "npm version patch --no-git-tag-version && npm shrinkwrap",
    "bundle": "zip -r robocodejs-$(node -p \"require('./package.json').version\").zip ./ -x 'src/*' -x 'test/*' -x 'coverage/*' -x '*.git' -x '*robocodejs*zip*' -x '*artifact.zip*' -x '*node_modules*'"
  },
  "author": "Lee Adcock <lee@robocodejs.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "browser-bunyan": "^1.8.0",
    "cookie-parser": "^1.4.6",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "glin-profanity": "^4.0.1",
    "globals": "^17.13.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "isolated-vm": "^6.2.0",
    "ml-classify-text": "^2.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prettier": "^3.9.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "npm-run-all2": "^9.0.4",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "npm": ">=10.0.0"
  }
}
